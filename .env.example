# SB Centre Real Website — example only, do NOT put real secrets in git.
# This is a plain static frontend, so the app reads config.js, not .env.
# Copy these values into config.js after creating your Supabase project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code or in git.
# Admin login uses Supabase Auth (email + password) created in the dashboard.
